# JWT
JWT_SECRET=changeme-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Firestore emulator
FIRESTORE_EMULATOR_HOST=firestore:8080
GOOGLE_CLOUD_PROJECT=workflow-platform-dev

# Redis
REDIS_URL=redis://redis:6379/0

# SMTP (Mailhog in dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@workflow.local

# Service ports (used in docker-compose only, not in app code)
AUTH_PORT=8001
TENANT_USER_PORT=8002
WORKFLOW_PORT=8003
NOTIFICATION_PORT=8004
AUDIT_PORT=8005
