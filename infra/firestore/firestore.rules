rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    match /audit_logs/{logId} {
      allow create: if false;
      allow read:   if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
